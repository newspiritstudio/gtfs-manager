# GTFS Manager: static files, nothing runs on the server. The feeds live in each visitor's
# browser. `deploy.sh` uploads a release to /opt/gtfs-manager/site/releases/<revision> and points
# `current` at it; the Caddy container sees /opt/gtfs-manager/site as /srv/gtfs-manager.
gtfs.newspirit.studio {
	encode zstd gzip
	root * /srv/gtfs-manager/current

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Hashed file names never change; the HTML is checked on every visit.
	@hashed path /assets/* /fonts/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@images path /flags/* /catalog-logos/* /landing-networks/*
	header @images Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
	@html not path /assets/* /fonts/* /flags/* /catalog-logos/* /landing-networks/*
	header @html Cache-Control "no-cache"

	# A prerendered public page if there is one; otherwise the app itself, which routes in the
	# browser (the workspace, and the "not found" page).
	try_files {path} {path}/index.html /404.html
	file_server
}

# The longer name redirects to the canonical one (a single address for search engines).
gtfsmanager.newspirit.studio {
	redir https://gtfs.newspirit.studio{uri} permanent
}
