{
  "name": "gtfs-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Import, explore, edit, validate and export GTFS feeds in the browser",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://gtfs.newspirit.studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newspiritstudio/gtfs-manager.git"
  },
  "bugs": {
    "url": "https://github.com/newspiritstudio/gtfs-manager/issues"
  },
  "keywords": [
    "gtfs",
    "gtfs-editor",
    "gtfs-viewer",
    "gtfs-validator",
    "public-transport",
    "transit",
    "nextjs"
  ],
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"app/**/*.{ts,tsx}\" \"shared/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"app/**/*.{ts,tsx}\" \"shared/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "i18n:check": "tsx scripts/check-locales.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "gtfs:import": "tsx --env-file-if-exists=.env.local scripts/import-gtfs.ts",
    "prepare": "husky || true",
    "landing:network": "tsx --env-file-if-exists=.env.local scripts/build-landing-network.ts",
    "realtime:proto": "node scripts/realtime-proto.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "protobufjs": "^8.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0 <12"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
